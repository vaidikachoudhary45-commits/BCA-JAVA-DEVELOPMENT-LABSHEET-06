
import java.util.ArrayList;

public class Main {
    public static void main(String[] args) {
        ArrayList<Integer> numbers = new ArrayList<>();

        for (int i = 1; i <= 10; i++) {
            numbers.add(i * 10);
        }

        System.out.println("Numbers are:");
        for (Integer n : numbers) {
            System.out.println(n);
        }
    }
}
